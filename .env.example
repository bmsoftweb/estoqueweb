# Porta do EstoqueWEB (portal B2B 3000, admin B2B 3001, comprasWeb 3002)
ESTOQUE_PORT=3003

# ------------------------------------------------------------
# Servidores da bmAPI (D:\bmsoft\BMapi)
# No login o usuário digita o número do servidor; URL, porta e token (X-API-Key)
# vêm da tabela servidores deste MySQL. O token nunca chega ao navegador.
# A base do servidor precisa estar com allowWrite=true no config.ini da bmAPI.
# ------------------------------------------------------------
MYSQL_HOST=45.224.130.145
MYSQL_PORT=3306
MYSQL_USER=bmsoftadm
MYSQL_PASSWORD=
MYSQL_DATABASE=bmapi

# Segredo usado para assinar o token de sessão (qualquer texto longo e aleatório)
SESSION_SECRET=

# ------------------------------------------------------------
# Regras de negócio de cada empresa (equivalentes ao estoqueWeb.ini do app Delphi)
# NÃO ficam aqui: vão no campo config da tabela servidores (MySQL), uma CHAVE=VALOR
# por linha. Chave ausente usa o padrão do código (entre parênteses).
#   ID_EMPRESA (1)              empresa (EMPRESAS.ID) do estoque e da numeração dos DAVs
#   CONSISTIR_FINANCEIRO (S)    bloqueia novo pedido com título vencido há mais de DIAS_EM_ATRASO dias
#   DIAS_EM_ATRASO (3)
#   CONSISTIR_BLOQUEIO (N)      bloqueia novo pedido quando PESSOAS.ID_BLOQ > 0
#   APRESENTAR_ESTOQUE (S)      painéis laterais da pesquisa de estoque
#   APRESENTAR_SIMILARES (S)
#   PLANO_PADRAO_AGENDADOR (7)  plano da rotina da meia-noite para pedido sem plano
# ------------------------------------------------------------

# ------------------------------------------------------------
# Rotina da meia-noite (equivalente ao estoqueWeb_backend.exe):
# fecha os pedidos ainda abertos e desfaz as pré-reservas.
# ------------------------------------------------------------
AGENDADOR_MEIA_NOITE=N
# Número(s) do servidor (tabela servidores) em que a rotina roda, ex.: 1 ou 1,3
AGENDADOR_SERVIDOR=
# Na Vercel a rotina roda pelo Cron (vercel.json, 03:00 UTC = 00:00 de Brasília).
# A Vercel manda este segredo no header Authorization; sem ele a rota recusa.
CRON_SECRET=
