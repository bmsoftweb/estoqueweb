# Porta do EstoqueWEB (portal B2B 3000, admin B2B 3001, comprasWeb 3002)
ESTOQUE_PORT=3003

# ------------------------------------------------------------
# Servidores da bmAPI (D:\bmsoft\BMapi)
# No login o usuário digita o número do servidor; URL, porta e token (X-API-Key)
# vêm da tabela servidores deste MySQL. O token nunca chega ao navegador.
# A base do servidor precisa estar com allowWrite=true no config.ini da bmAPI.
# ------------------------------------------------------------
MYSQL_HOST=45.224.130.145
MYSQL_PORT=3306
MYSQL_USER=bmsoftadm
MYSQL_PASSWORD=
MYSQL_DATABASE=bmapi

# Segredo usado para assinar o token de sessão (qualquer texto longo e aleatório)
SESSION_SECRET=

# ------------------------------------------------------------
# Regras de negócio (equivalentes ao estoqueWeb.ini do app Delphi)
# Cada cliente pode ter as suas no campo servidores.config (MySQL), uma CHAVE=VALOR
# por linha. O que estiver lá vale para o servidor; o que faltar vem daqui.
# ------------------------------------------------------------
# Empresa (EMPRESAS.ID) cujo estoque e numeração de pedidos são usados
ID_EMPRESA=1
# Bloqueia novo pedido quando o cliente tem título em aberto vencido há mais de DIAS_EM_ATRASO dias
CONSISTIR_FINANCEIRO=S
DIAS_EM_ATRASO=3
# Bloqueia novo pedido quando PESSOAS.ID_BLOQ > 0
CONSISTIR_BLOQUEIO=N
# Painéis laterais da pesquisa de estoque
APRESENTAR_ESTOQUE=S
APRESENTAR_SIMILARES=S

# ------------------------------------------------------------
# Rotina da meia-noite (equivalente ao estoqueWeb_backend.exe):
# fecha os pedidos ainda abertos e desfaz as pré-reservas.
# ------------------------------------------------------------
AGENDADOR_MEIA_NOITE=N
# Número do servidor (tabela servidores) em que a rotina roda
AGENDADOR_SERVIDOR=
# Plano de pagamento usado pela rotina quando o pedido não tem plano
PLANO_PADRAO_AGENDADOR=7
